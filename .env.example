# Service-user key (cog_…) and org id from Devin Settings.
# Science runs in the Cloud sandbox. These are required for the job API.
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Linux snapshot that already has this repo plus mmseqs/mafft/foldseek/mkdssp.
DEVIN_SNAPSHOT_ID=

