# Service-user key (cog_…) and org id from Devin Settings.
# Science runs in the Cloud sandbox. These are required for the job API.
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Linux snapshot that already has this repo plus mmseqs/mafft/foldseek/mkdssp.
DEVIN_SNAPSHOT_ID=

# Optional overrides
# DEVIN_REPO=anirudh027/ehl-cognition-2026
# DEVIN_BASE_URL=https://api.devin.ai
# DEVIN_PLAYBOOK_ID=

# Hosting overrides. Use a durable mounted path for production job data.
# RUNS_DIR=/data/ehl-cognition/jobs
# CORS_ORIGINS=https://your-app.vercel.app,https://research.example.com

# Frontend build variable when the API is hosted separately from Vercel.
# VITE_API_BASE_URL=https://api.research.example.com
