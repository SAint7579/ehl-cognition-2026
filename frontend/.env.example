# Public Supabase project settings used by the browser auth client.
# Never put the Supabase service role key in this file or any frontend build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional separate backend origin; leave unset for local Vite proxying.
# VITE_API_BASE_URL=https://api.research.example.com
