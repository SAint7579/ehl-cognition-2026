{
  "$defs": {
    "FileDigest": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "FileDigest",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argv"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "KNOWN",
            "CALCULATED",
            "PREDICTED",
            "EXPERIMENTAL"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "input_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Input Files",
          "type": "array"
        },
        "output_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Output Files",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "tool_name",
        "tool_version",
        "parameters",
        "input_files",
        "output_files",
        "started_at",
        "ended_at",
        "duration_seconds",
        "evidence_type"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "StageArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "artifact_paths",
        "provenance"
      ],
      "title": "StageArtifact",
      "type": "object"
    }
  },
  "$id": "https://example.org/bio-tools/schemas/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "input_files": {
      "items": {
        "$ref": "#/$defs/FileDigest"
      },
      "title": "Input Files",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageArtifact"
      },
      "title": "Stages",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "pipeline_version",
    "run_id",
    "started_at",
    "ended_at",
    "input_files",
    "stages",
    "environment",
    "limitations"
  ],
  "schema_version": "1.0.0",
  "title": "RunArtifact",
  "type": "object"
}
