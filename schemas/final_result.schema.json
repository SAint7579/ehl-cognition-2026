{
  "$defs": {
    "CandidateSubstitutionOption": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "evidence_type": {
          "const": "CALCULATED",
          "default": "CALCULATED",
          "title": "Evidence Type",
          "type": "string"
        },
        "frequency": {
          "title": "Frequency",
          "type": "number"
        },
        "residue": {
          "title": "Residue",
          "type": "string"
        },
        "source": {
          "const": "observed_in_homologs",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "residue",
        "count",
        "frequency",
        "source"
      ],
      "title": "CandidateSubstitutionOption",
      "type": "object"
    },
    "ConstraintRecord": {
      "additionalProperties": false,
      "properties": {
        "enforcement": {
          "enum": [
            "ENFORCED_BY_PIPELINE",
            "RECORDED_ONLY"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "enforcement",
        "note"
      ],
      "title": "ConstraintRecord",
      "type": "object"
    },
    "FileDigest": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "FileDigest",
      "type": "object"
    },
    "FinalResultShortlist": {
      "additionalProperties": false,
      "properties": {
        "n_total": {
          "title": "N Total",
          "type": "integer"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "sites": {
          "items": {
            "$ref": "#/$defs/FinalResultSite"
          },
          "title": "Sites",
          "type": "array"
        },
        "top_n": {
          "title": "Top N",
          "type": "integer"
        }
      },
      "required": [
        "objective",
        "n_total",
        "top_n",
        "sites"
      ],
      "title": "FinalResultShortlist",
      "type": "object"
    },
    "FinalResultSite": {
      "additionalProperties": false,
      "properties": {
        "author_residue": {
          "title": "Author Residue",
          "type": "integer"
        },
        "conservation": {
          "title": "Conservation",
          "type": "number"
        },
        "distance_to_active_site_angstrom": {
          "title": "Distance To Active Site Angstrom",
          "type": "number"
        },
        "evidence_type": {
          "const": "CALCULATED",
          "title": "Evidence Type",
          "type": "string"
        },
        "one_letter": {
          "title": "One Letter",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "rsa": {
          "title": "Rsa",
          "type": "number"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "substitution_options": {
          "items": {
            "$ref": "#/$defs/CandidateSubstitutionOption"
          },
          "title": "Substitution Options",
          "type": "array"
        },
        "target_position": {
          "title": "Target Position",
          "type": "integer"
        }
      },
      "required": [
        "rank",
        "author_residue",
        "target_position",
        "one_letter",
        "conservation",
        "rsa",
        "distance_to_active_site_angstrom",
        "score",
        "substitution_options",
        "evidence_type"
      ],
      "title": "FinalResultSite",
      "type": "object"
    },
    "InvestigationInputs": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "title": "Chain",
          "type": "string"
        },
        "database": {
          "$ref": "#/$defs/FileDigest"
        },
        "references_path": {
          "title": "References Path",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/FileDigest"
        },
        "target": {
          "$ref": "#/$defs/FileDigest"
        }
      },
      "required": [
        "target",
        "database",
        "structure",
        "references_path",
        "chain"
      ],
      "title": "InvestigationInputs",
      "type": "object"
    },
    "InvestigationStage": {
      "additionalProperties": false,
      "properties": {
        "artifact_digests": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Artifact Digests",
          "type": "array"
        },
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Paths",
          "type": "array"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duration Seconds"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ProvenanceRecord"
          },
          "title": "Provenance",
          "type": "array"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "SKIPPED"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/StructureWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "status",
        "started_at",
        "ended_at",
        "duration_seconds",
        "artifact_paths",
        "artifact_digests",
        "provenance",
        "warnings",
        "error"
      ],
      "title": "InvestigationStage",
      "type": "object"
    },
    "InvestigationWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "title": "Severity",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "stage"
      ],
      "title": "InvestigationWarning",
      "type": "object"
    },
    "PlaybookReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/FileDigest"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "path",
        "digest"
      ],
      "title": "PlaybookReference",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argv"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "KNOWN",
            "CALCULATED",
            "PREDICTED",
            "EXPERIMENTAL"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "input_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Input Files",
          "type": "array"
        },
        "output_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Output Files",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "tool_name",
        "tool_version",
        "parameters",
        "input_files",
        "output_files",
        "started_at",
        "ended_at",
        "duration_seconds",
        "evidence_type"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "StructureWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "StructureWarning",
      "type": "object"
    }
  },
  "$id": "https://example.org/bio-tools/schemas/final_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_index": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Artifact Index",
      "type": "object"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/ConstraintRecord"
      },
      "title": "Constraints",
      "type": "array"
    },
    "duration_seconds": {
      "title": "Duration Seconds",
      "type": "number"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "evidence_labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Evidence Labels",
      "type": "object"
    },
    "inputs": {
      "$ref": "#/$defs/InvestigationInputs"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "playbook": {
      "$ref": "#/$defs/PlaybookReference"
    },
    "result_version": {
      "const": "v1",
      "default": "v1",
      "title": "Result Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "shortlists": {
      "additionalProperties": {
        "$ref": "#/$defs/FinalResultShortlist"
      },
      "propertyNames": {
        "enum": [
          "activity",
          "stability"
        ]
      },
      "title": "Shortlists",
      "type": "object"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/InvestigationStage"
      },
      "title": "Stages",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/InvestigationWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "playbook",
    "objective",
    "constraints",
    "inputs",
    "started_at",
    "ended_at",
    "duration_seconds",
    "stages",
    "artifact_index",
    "shortlists",
    "evidence_labels",
    "environment",
    "warnings",
    "limitations"
  ],
  "schema_version": "1.0.0",
  "title": "FinalResultArtifact",
  "type": "object"
}
