  "$id": "https://example.org/bio-tools/schemas/structure_summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chain": {
      "title": "Chain",
      "type": "string"
