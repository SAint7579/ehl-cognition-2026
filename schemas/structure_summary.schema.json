        "type": "string"
      },
      "title": "Unmodelled Target Ranges",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/StructureWarning"
      },
      "title": "Warnings",
      "type": "array"
    }
