      "additionalProperties": {
        "type": "integer"
      },
      "title": "Residue Counts",
      "type": "object"
    },
    "reverse_index": {
      "items": {
        "$ref": "#/$defs/ReverseIndexEntry"
      },
      "title": "Reverse Index",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_structure": {
