    "structure_id",
    "chain",
    "deposition",
    "target_id",
    "target_length",
    "residue_counts",
    "modelled_residue_count",
    "modelled_range",
    "unmodelled_target_ranges",
    "secondary_structure",
    "foldseek_hits",
    "numbering",
    "reverse_index",
    "warnings",
    "provenance",
    "limitations"
  ],
  "schema_version": "1.0.0",
  "title": "StructureSummaryArtifact",
  "type": "object"
}
