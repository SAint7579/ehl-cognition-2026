    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Argv"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "KNOWN",
            "CALCULATED",
            "PREDICTED",
            "EXPERIMENTAL"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "input_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Input Files",
          "type": "array"
        },
        "output_files": {
          "items": {
            "$ref": "#/$defs/FileDigest"
          },
          "title": "Output Files",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "tool_name",
        "tool_version",
        "parameters",
        "input_files",
        "output_files",
        "started_at",
        "ended_at",
        "duration_seconds",
        "evidence_type"
